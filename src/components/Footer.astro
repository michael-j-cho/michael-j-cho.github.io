---
import Link from '@/components/Link.astro'
import { NAV_LINKS, SITE, SOCIAL_LINKS } from '@/consts'
import { Icon } from 'astro-icon/components'
import SocialIcons from './SocialIcons.astro'

const isExternalLink = (href: string) => {
  return href.startsWith('http')
}
---

<footer class="bg-background/80 border-border/50 border-t backdrop-blur-md">
  <div class="w-full px-4 py-8 sm:py-10">
    <div class="mx-auto flex max-w-3xl flex-col gap-8">
      <!-- Subtle Separator -->
      <div class="bg-border/30 h-px" aria-hidden="true"></div>

      <!-- Main Footer Content -->
      <div
        class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 lg:gap-8"
      >
        <!-- Navigation -->
        <div>
          <h4 class="text-foreground mb-3 text-sm font-semibold">Navigation</h4>
          <nav class="flex flex-col gap-2">
            {
              NAV_LINKS.map((item) => {
                const isExternal = isExternalLink(item.href)
                return (
                  <Link
                    href={item.href}
                    class="text-muted-foreground hover:text-primary group flex items-center gap-1.5 text-sm capitalize transition-colors"
                  >
                    <span>{item.label}</span>
                    {isExternal && (
                      <Icon
                        name="lucide:external-link"
                        class="group-hover:text-primary size-3 flex-shrink-0 opacity-70 transition-colors group-hover:opacity-100"
                        aria-hidden="true"
                      />
                    )}
                  </Link>
                )
              })
            }
          </nav>
        </div>

        <!-- Connect -->
        <div>
          <h4 class="text-foreground mb-3 text-sm font-semibold">Connect</h4>
          <SocialIcons links={SOCIAL_LINKS} />
        </div>
      </div>

      <!-- Separator -->
      <div class="bg-border/60 h-px" aria-hidden="true"></div>

      <!-- Bottom Section -->
      <div
        class="text-muted-foreground flex flex-col items-center gap-2 text-sm sm:flex-row sm:justify-between"
      >
        <div class="text-center sm:text-left">
          &copy; {new Date().getFullYear()}
          {SITE.title}. All rights reserved.
        </div>
      </div>
    </div>
  </div>
</footer>
