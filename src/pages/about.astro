---
import PageHead from '@/components/PageHead.astro'
import { PERSON_SCHEMA } from '@/consts'
import Layout from '@/layouts/Layout.astro'
// Lives outside src/content/authors so it doesn't generate a second author page
import { Content as AboutContent } from '../content/about.md'
---

<Layout class="max-w-3xl">
  <PageHead slot="head" title="About" description="About Michael Cho: Ph.D. candidate at Georgia Tech and Applied Machine Learning Scientist Co-op at WHOOP." />

  <script type="application/ld+json" set:html={JSON.stringify(PERSON_SCHEMA)} />

  <section class="flex flex-col gap-8">
    <div class="flex flex-col gap-4">
      <div>
        <h1 class="text-3xl font-bold md:text-4xl">About</h1>
        <!-- <p class="text-muted-foreground mt-1 font-mono text-sm"> -->
        <!--   Learn more about this blog -->
        <!-- </p> -->
      </div>
    </div>
    <div class="prose prose-sm dark:prose-invert max-w-none space-y-6">
      <AboutContent />
    </div>
  </section>
</Layout>
